[Unit]
Description=QuiQuiz
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/quiquiz
EnvironmentFile=/var/www/quiquiz/.env
Environment=NODE_ENV=production
# Node 20 est en fin de vie depuis avril 2026. Garder /usr/bin/node sur une version encore supportée (22 LTS).
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
